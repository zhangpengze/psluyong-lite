# ===== 必填（缺失则启动失败）=====
# 复制本文件为 .env 后填写。生成随机值：
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=请替换为随机字符串
API_KEY=请替换为随机字符串
ADMIN_USERNAME=admin
ADMIN_PASSWORD=请替换为强密码

# ===== 数据库 =====
# 默认 SQLite，文件落在 server/data/app.db
# DATABASE_URL=sqlite:///data/app.db
# SQLite 日志模式：默认 WAL（读写不互斥，多线程提交不会 database is locked）。
# 只有把 data 目录放在 NFS/SMB 网络共享上时才需要改成 DELETE。
# SQLITE_JOURNAL_MODE=WAL

# ===== 目录（默认 server/data 下）=====
# DATA_DIR=
# IMAGES_DIR=
# TEMPLATES_DIR=          # 预留（2026-10-24 审计核实：当前代码未消费此键，保留待客户端模板目录方案定型）
# BACKUP_DIR=

# ===== 数据库备份 =====
# 每天自动热备一份（gzip），保留最近 N 份；手动随时执行 python -m server.backup
# BACKUP_KEEP=10
# BACKUP_HOUR=3
# BACKUP_MINUTE=30

# ===== 成品图备份（强烈建议配）=====
# 数据库有备份而图片没有 = 只保住了索引。把 NAS 第二块盘/另一台共享目录
# 挂到容器 /app/mirror（见 docker-compose 里注释的 volumes），这里填该容器路径。
# 留空则不镜像，启动日志会打一条 warning。
# IMAGES_MIRROR_DIR=/app/mirror
# 图片占用告警阈值（GB），超过推一次群
# DISK_ALERT_GB=20
# 运维类告警开关（备份失败/镜像失败/磁盘超阈值/定时日报未推送）
# ALERT_ON_OPS_FAILURE=1

# ===== 日报推送 =====
ENABLE_SCHEDULER=1
DAILY_REPORT_HOUR=18
DAILY_REPORT_MINUTE=0
# 次日终版巡检：18:00 推的是当日快报，18:00 之后员工补录的记录不在里面。
# 每天这个时点重算昨天的日报，数据变了才补推一条「（终版）」，没变一条都不发。
# 它同时兜住"18:00 服务没起来/推送失败"——那种情况定时任务补不回来。
REPORT_FINAL_HOUR=8
REPORT_FINAL_MINUTE=30
# 巡检往前看几天找"该有日报却没推成功"的日子（只发一条运维告警，不自动补推）
REPORT_MISS_LOOKBACK_DAYS=7
# NapCat / OneBot HTTP 上报地址。用 NAS 的局域网 IP（Docker 项目之间
# 容器名解析不到），例如 http://192.168.1.10:13000
# 注意：Token 填 NapCat「网络配置」里 HTTP 服务端的鉴权 Token，不是 WebUI 的
NAPCAT_WEBHOOK=
NAPCAT_TOKEN=
# 推送目标 QQ 群号
REPORT_GROUP_ID=

# ===== QQ 机器人反向指令（可选）=====
# 群里发「汇总」→ 私聊回复当天日报。需在 NapCat 网络配置里把
# 群消息上报到 http://NAS的IP:端口/api/v1/bot/onebot
#
# 2026-10-24 起默认 fail-closed（这两个键留空 = 指令完全不响应）：
#   - 回调密钥留空 → 拒绝所有上报；匿名可达等于把含员工姓名/稿件标题的报表
#     开放给任何能碰到 NAS 端口的人
#   - QQ 白名单留空 → 谁都不能触发（旧语义"留空=所有人"已废弃）
# 允许触发指令的 QQ 号，逗号分隔
BOT_ADMIN_QQ_IDS=
# 允许触发指令的群号，逗号分隔；留空 = 只允许 REPORT_GROUP_ID 那一个群
BOT_ALLOWED_GROUP_IDS=
# 回调校验密钥：NapCat 上报请求头 X-Bot-Secret 带同一个值才处理
BOT_CALLBACK_SECRET=
# 逃生阀：仅完全隔离的内网/本机调试才设 1（允许无密钥回调，启动会 warning）
BOT_ALLOW_INSECURE=0
# 同一人触发冷却秒数（防连点）
# BOT_COOLDOWN_S=10

# ===== 失败即时告警 =====
# 录用失败立刻推群（推到 REPORT_GROUP_ID），不等当天日报
ALERT_ON_FAILURE=1
# 告警最小间隔秒数：PS 故障时批量失败不会把群刷爆
ALERT_MIN_INTERVAL_S=5

# ===== 其他 =====
TZ=Asia/Shanghai
MAX_UPLOAD_MB=64
FORCE_HTTPS=0
# 服务监听（容器部署不用改；要改宿主机映射端口用 SERVER_PORT）
# HOST=0.0.0.0
# PORT=8080
# SERVER_PORT=8080        # 两份 docker-compose 的宿主机端口映射（容器内固定 8080）
# FLASK_DEBUG=1           # 开发排障用，生产环境禁开（会启用调试器与 reloader）
