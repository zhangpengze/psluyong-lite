# ===== 必填（缺失则启动失败）=====
# 复制本文件为 .env 后填写。生成随机值：
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=请替换为随机字符串
API_KEY=请替换为随机字符串
ADMIN_USERNAME=admin
ADMIN_PASSWORD=请替换为强密码

# ===== 数据库 =====
# 默认 SQLite，文件落在 server/data/app.db
# DATABASE_URL=sqlite:///data/app.db
# SQLite 日志模式：默认 WAL（读写不互斥，多线程提交不会 database is locked）。
# 只有把 data 目录放在 NFS/SMB 网络共享上时才需要改成 DELETE。
# SQLITE_JOURNAL_MODE=WAL

# ===== 目录（默认 server/data 下）=====
# DATA_DIR=
# IMAGES_DIR=
# TEMPLATES_DIR=          # 预留（2026-10-24 审计核实：当前代码未消费此键，保留待客户端模板目录方案定型）
# BACKUP_DIR=

# ===== 数据库备份 =====
# 每天自动热备一份（gzip），保留最近 N 份；手动随时执行 python -m server.backup
# BACKUP_KEEP=10
# BACKUP_HOUR=3
# BACKUP_MINUTE=30

# ===== 成品图备份（强烈建议配）=====
# 数据库有备份而图片没有 = 只保住了索引。把 NAS 第二块盘/另一台共享目录
# 挂到容器 /app/mirror（见 docker-compose 里注释的 volumes），这里填该容器路径。
# 留空则不镜像，启动日志会打一条 warning。
# IMAGES_MIRROR_DIR=/app/mirror
# 图片占用告警阈值（GB），超过推一次群
# DISK_ALERT_GB=20
# 运维类告警开关（备份失败/镜像失败/磁盘超阈值/定时日报未推送）
# ALERT_ON_OPS_FAILURE=1

# ===== 日报推送 =====
ENABLE_SCHEDULER=1
DAILY_REPORT_HOUR=18
DAILY_REPORT_MINUTE=0
# 次日终版巡检：18:00 推的是当日快报，18:00 之后员工补录的记录不在里面。
# 每天这个时点重算昨天的日报，数据变了才补推一条「（终版）」，没变一条都不发。
# 它同时兜住"18:00 服务没起来/推送失败"——那种情况定时任务补不回来。
REPORT_FINAL_HOUR=8
REPORT_FINAL_MINUTE=30
# 巡检往前看几天找"该有日报却没推成功"的日子（只发一条运维告警，不自动补推）
REPORT_MISS_LOOKBACK_DAYS=7
# ===== 官方 QQ 机器人（推送日报/告警用）=====
# 走 QQ 开放平台（https://api.bot.qq.com），AppID/AppSecret 在 q.qq.com 后台拿，
# AppSecret 只显示一次，丢了只能重置（旧值立刻失效）。
# 三项缺任何一项 → 日报只生成不推送，仪表盘那一行显示灰色「未配置」。
QQ_BOT_APPID=
QQ_BOT_SECRET=
# 群的 openid —— **不是群号**（填群号会拿到 40054002）。只能靠探针脚本拿：
# 服务端没有入站端点，@ 机器人不会进服务端日志。在开发机上跑
# .venv/Scripts/python.exe scripts/qqbot_spike.py（先在 .env 填 AppID/Secret、
# 把开发机出口 IP 加进白名单，再在群里 @ 机器人），事件里带的 group_openid 即它。
QQ_BOT_GROUP_OPENID=
# 接口域名。2026-08-10 起官方统一到 api.bot.qq.com（旧 api.sgroup.qq.com 已下线），
# 取 access_token 也在同一域名下；留空即用默认值。只有内网反代/私有网关才需要改。
# QQ_BOT_API_BASE=https://api.bot.qq.com
#
# 上线前必须做的两件事（漏了会一直 40034102「主动消息失败, 无权限」）：
#   1. 手机 QQ → 该群 → 设置 → 机器人 → 打开「机器人主动在群聊内发言」
#   2. q.qq.com 后台把 NAS 的出口公网 IP 加进机器人 IP 白名单
#
# 老版本的 NapCat（登录一个真 QQ 号）方案已整体删除。升级时把 .env 里的
# NAPCAT_WEBHOOK / NAPCAT_TOKEN / REPORT_GROUP_ID 三行删掉，并停掉 napcat 容器。

# ===== 失败即时告警 =====
# 录用失败立刻推群，不等当天日报
ALERT_ON_FAILURE=1
# 告警最小间隔秒数：PS 故障时批量失败不会把群刷爆
ALERT_MIN_INTERVAL_S=5

# ===== 其他 =====
TZ=Asia/Shanghai
MAX_UPLOAD_MB=64
FORCE_HTTPS=0
# 服务监听（容器部署不用改；要改宿主机映射端口用 SERVER_PORT）
# HOST=0.0.0.0
# PORT=8080
# SERVER_PORT=8080        # 两份 docker-compose 的宿主机端口映射（容器内固定 8080）
# FLASK_DEBUG=1           # 开发排障用，生产环境禁开（会启用调试器与 reloader）
