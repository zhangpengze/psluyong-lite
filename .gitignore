.venv/
__pycache__/
*.pyc
.env
# 环境文件的所有变体与备份一律不入库（.env.local/.env.bak.ci/.env.prod 等），
# 只放行模板。真实教训：复现 CI「没有 .env」时 `cp .env .env.bak.ci`，
# 该文件被 git add -A 带进公开仓库，密钥类配置差点泄出去。
.env.*
!.env.example
server/data/
*.db
.pytest_cache/
client/node_modules/
client/dist/
client/src-tauri/target/
# 打包产物由 scripts/build_sidecar.ps1 生成，仓库只留占位说明
client/src-tauri/sidecar-dist/*
!client/src-tauri/sidecar-dist/README.txt
logs/

# 本地演示产物
.shots/
.verify/
.demo-client/
.demo-output/
.pytest_cache/

# WorkBuddy 项目数据（记忆/日志），不属于源码
.workbuddy/

# NAS 打包产物与随包数据（scripts/package_nas.py 默认输出到桌面，
# 这里兜住 --out 指到仓库内、或手动把 data/ 拷到 deploy 下的情况）
psluyong-lite-nas-*.zip
deploy/nas/data/

# 覆盖率产物（pytest-cov）
.coverage
.coverage.*
htmlcov/
